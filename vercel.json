{
  "version": 2,
  "builds": [
    {
      "src": "minor/minor/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.10"
      }
    },
    {
      "src": "minor/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "minor/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "minor/minor/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "minor.settings",
    "PYTHONPATH": "minor"
  }
}
